# Ollama Configuration - For AI Chatbot
# Cloud: https://ollama.com/v1 with a key from https://ollama.com/settings/keys
# Local: http://localhost:11434/v1 (any non-empty key value works)
OLLAMA_API_KEY=$OLLAMA_API_KEY
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

# Sanity.io Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=$SANITY_PROJECT_ID
NEXT_PUBLIC_SANITY_DATASET=$SANITY_DATASET
NEXT_PUBLIC_SANITY_API_VERSION=$SANITY_API_VERSION

# Supabase - For Analytics
NEXT_PUBLIC_SUPABASE_URL=$SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

# Github Configuration
GITHUB_TOKEN=$GITHUB_TOKEN

# Gmail SMTP - For Contact Form Email
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# reCAPTCHA v3 - For Bot Protection (Optional but Recommended)
# Get keys from: https://www.google.com/recaptcha/admin/create
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key