# Rahfi's Portfolio (frontend): environment reference
# Copy to `.env` and fill in the real values by hand. `.env` is gitignored and is
# never read, printed, or copied by anyone, including an AI assistant, per
# docs/rules/env.rules.md. Only this example file is ever opened.
#
# Keep this file in step with the code: a new variable is added here in the same
# commit that introduces it, so the example never falls behind what runs.
#
# NO NEXT_PUBLIC_ PREFIX
# Nothing in this file carries the NEXT_PUBLIC_ prefix, and nothing may be given
# it. A prefixed value is compiled into the JavaScript bundle the browser
# downloads and is public the moment it ships. Every variable here is read on
# the server; the one value the browser needs is handed to its page as a
# prop. See docs/rules/secret.rules.md.
#
# WHAT IS NOT HERE
# This is the site. The backend is on the backend-main and backend-dev branches,
# deployed as its own project with its own environment: the service role key,
# the sealing key, and the mail fallback live there and nowhere else. The model
# key, the mail password, and the storage service account are not environment
# variables at all; they are set in /studio > Settings.


# The backend
# Where /api is forwarded. Not a secret. Locally it defaults to
# http://127.0.0.1:8000 when unset, which is where the backend's uvicorn runs.
BACKEND_URL=https://api.rahfi.pro

# Service key: SECRET
# Sent with every forwarded request, alongside the visitor's address. The
# backend only believes that address when this matches its own value, so both
# deployments, and the consulting site, hold the same string.
STUDIO_SERVICE_KEY=your_long_random_service_key_here


# Supabase: published content and visitor analytics
# The anon key reads published content and writes the visitor counters. It would
# be safe in the browser: row-level security is what protects the data behind
# it, and the policies live in the backend branches, under supabase/migrations/.
# Obtain from: Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here


# GitHub statistics: SECRET
# Read only inside the API route (src/app/api/github/stats/route.ts).
# A fine-grained token with PUBLIC REPOSITORY READ ONLY is sufficient. Grant no
# write scope: this token only counts repositories and lists recent ones.
# Obtain from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here


# Bot protection: the site key
# Identifies the site to Google. The contact page reads it on the server and
# hands it to the captcha script. The matching secret key is in the backend's
# environment, and the two are different strings from the same reCAPTCHA site.
# Obtain from: https://www.google.com/recaptcha/admin/create  (reCAPTCHA v3)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
