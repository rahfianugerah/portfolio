# Rahfi's Portfolio: environment reference
# Copy to `.env` and fill in the real values by hand. `.env` is gitignored and is
# never read, printed, or copied by anyone, including an AI assistant, per
# docs/rules/env.rules.md. Only this example file is ever opened.
#
# Keep this file in step with the code: a new variable is added here in the same
# commit that introduces it, so the example never falls behind what runs.
#
# NO NEXT_PUBLIC_ PREFIX
# Nothing in this file carries the NEXT_PUBLIC_ prefix, and nothing may be given
# it. A prefixed value is compiled into the JavaScript bundle the browser
# downloads and is public the moment it ships. Every variable here is read on
# the server; the one value the browser needs is handed to its page as a
# prop. See docs/rules/secret.rules.md.
#
# WHAT IS NOT HERE
# The model key and model name, the mail password, and the storage service
# account are set in /studio > Settings, as LLM_API_KEY, LLM_MODEL,
# SMTP_PASSWORD, GCS_SERVICE_ACCOUNT and the rest. They are sealed with
# AES-256-GCM before they reach the database. What stays in this file is what
# the studio itself needs in order to open.


# Supabase: content, posts, analytics, and the studio's own tables
# The anon key reads published content and writes the visitor counters. It would
# be safe in the browser: row-level security is what protects the data behind
# it, and the policies live in supabase/migrations/.
# Obtain from: Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# The service role key BYPASSES every policy. Only the FastAPI backend reads it,
# and it is what lets the studio write. It never reaches a page or a browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


# The studio: SECRET
# STUDIO_ENCRYPTION_KEY seals the owner's password digest and every credential
# saved in the studio. It must be 32 random bytes, base64 encoded:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing it makes every saved credential unreadable and the password unusable:
# the fix is to set a new key, reset the password by emailed code, and enter the
# credentials again. Keep a copy in a password manager.
STUDIO_ENCRYPTION_KEY=your_base64_32_byte_key_here

# Shared with the consulting deployment, which sends it to reach the model.
# Any long random string; the same value in both projects.
STUDIO_SERVICE_KEY=your_long_random_service_key_here

# The origins allowed to make a state-changing request. Comma separated, no
# trailing slash. Add http://localhost:3000 for local work.
ALLOWED_ORIGINS=https://rahfi.pro,https://consulting.rahfi.pro


# Mail fallback: SECRET
# Used only until SMTP is set in the studio, so that the code which sets the
# first password has a way to be sent. GMAIL_APP_PASSWORD is an App Password,
# not the account password: generate one with 2FA enabled.
# Obtain from: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@example.com
GMAIL_APP_PASSWORD=your_16_character_app_password


# GitHub statistics: SECRET
# Read only inside the API route (src/app/api/github/stats/route.ts).
# A fine-grained token with PUBLIC REPOSITORY READ ONLY is sufficient. Grant no
# write scope: this token only counts repositories and lists recent ones.
# Obtain from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here


# Bot protection: one secret, one site key
# The secret key verifies a token on the server and must never reach the client.
# The site key identifies the site to Google. The contact page reads it on the
# server and hands it to the captcha script, the one place it is needed.
# These are two different strings from the same reCAPTCHA site.
# Obtain both from: https://www.google.com/recaptcha/admin/create  (reCAPTCHA v3)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
